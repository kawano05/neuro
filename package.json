{
  "name": "neuronode-support-lab",
  "version": "0.1.0",
  "private": true,
  "description": "NeuroNode support app web prototype prepared for Capacitor iOS packaging.",
  "type": "module",
  "scripts": {
    "serve": "python -m http.server 5173 --directory www",
    "check": "node --check www/app.js && node --check www/sw.js",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  }
}
