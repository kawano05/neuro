{
  "name": "neuro",
  "version": "0.1.0",
  "private": true,
  "description": "neuro web prototype prepared for Capacitor iOS packaging.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "serve": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "check": "vite build",
    "test": "npm run test:web",
    "test:web": "npm run build && node tests/web-smoke.mjs",
    "test:web:headed": "npm run build && node tests/web-smoke.mjs --headed",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync ios",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "vite": "^6.0.0"
  }
}
